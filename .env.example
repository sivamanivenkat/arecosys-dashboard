# Copy to .env (never commit .env). Remove lines for sources you don't use.
DASHBOARD_DOMAIN=dashboard.example.com
ARECOSYS_DASHBOARD_PASSWORD=change-me-to-a-long-random-value

# Lead intake from the website backend
ARECOSYS_LEAD_TOKEN=change-me-to-another-long-random-value

# Optional HTTPS data endpoints (see README)
#ARECOSYS_WEBSITE_URL=
#ARECOSYS_WEBSITE_TOKEN=
#ARECOSYS_FLEET_URL=
#ARECOSYS_FLEET_TOKEN=
#ARECOSYS_INSTAGRAM_URL=
#ARECOSYS_INSTAGRAM_TOKEN=

# Optional Gmail inbox
#ARECOSYS_GMAIL_CLIENT_ID=
#ARECOSYS_GMAIL_CLIENT_SECRET=
#ARECOSYS_GMAIL_REFRESH_TOKEN=

# Design studio and Instagram publishing (see README). The public URL must be the HTTPS address
# of this dashboard, because Instagram downloads each post image from it.
ARECOSYS_PUBLIC_BASE_URL=https://dashboard.example.com
#ARECOSYS_INSTAGRAM_USER_ID=
#ARECOSYS_INSTAGRAM_ACCESS_TOKEN=

# Individual accounts (see README). Leave unset to use the single shared password above.
#ARECOSYS_USERS_FILE=/config/users.json

# Alerts and the Monday summary
#ARECOSYS_ALERT_EMAIL=
#ARECOSYS_ALERT_WEBHOOK_URL=

# Built-in sources
#ARECOSYS_GA4_PROPERTY_ID=
#ARECOSYS_GA4_CREDENTIALS_FILE=/config/ga4.json
#ARECOSYS_INSTAGRAM_INSIGHTS=1

# WhatsApp lead intake
#ARECOSYS_WHATSAPP_VERIFY_TOKEN=
#ARECOSYS_WHATSAPP_APP_SECRET=
